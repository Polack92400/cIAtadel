# cIAtadel — local development configuration.
# Copy to `.env` and replace every `change-me` value. Never commit `.env`.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector ----------------------------------------------------
POSTGRES_DB=ciatadel
POSTGRES_USER=ciatadel_owner
POSTGRES_PASSWORD=change-me
# The application connects as a NON-owner role so Row-Level Security applies.
APP_DB_USER=ciatadel_app
APP_DB_PASSWORD=change-me
DATABASE_URL=postgres://ciatadel_app:change-me@postgres:5432/ciatadel

# --- Redis / Celery -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO locally; leave S3_ENDPOINT_URL empty for AWS S3) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=ciatadel-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
S3_REGION=us-east-1
DOCUMENT_MAX_UPLOAD_MB=25

# --- AI providers -----------------------------------------------------------
# Providers: ollama | fake  (bedrock planned). Models are pulled by `make models`.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=120
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://ollama:11434
# Must match the embedding model output size (nomic-embed-text = 768).
EMBEDDING_DIM=768
RAG_TOP_K=6

# --- Frontend ---------------------------------------------------------------
BACKEND_INTERNAL_URL=http://backend:8000
