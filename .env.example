# cIAtadel — local configuration for docker compose.
# Create your .env with random secrets:   ./scripts/setup-env.sh
# (or copy this file to .env and replace every `change-me`). Never commit .env.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
JWT_SIGNING_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local stack is plain http on localhost; must be true behind HTTPS.
AUTH_COOKIE_SECURE=false
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector ----------------------------------------------------
POSTGRES_DB=ciatadel
# Owner role: runs migrations only.
POSTGRES_USER=ciatadel_owner
POSTGRES_PASSWORD=change-me
# Runtime role used by Django and Celery: not owner, no BYPASSRLS -> RLS applies.
APP_DB_USER=ciatadel_app
APP_DB_PASSWORD=change-me

# --- Object storage (MinIO) ---------------------------------------------------
MINIO_ROOT_USER=ciatadel-minio
MINIO_ROOT_PASSWORD=change-me
# Encryption-at-rest key for MinIO, format <name>:<base64 of 32 bytes>.
MINIO_KMS_SECRET_KEY=change-me-kms
S3_SSE=AES256
S3_BUCKET=ciatadel-documents
S3_REGION=us-east-1
DOCUMENT_MAX_UPLOAD_MB=25

# --- AI (Ollama) --------------------------------------------------------------
# Providers: ollama | fake. Models are downloaded automatically on first start.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=300
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model output size (nomic-embed-text = 768).
EMBEDDING_DIM=768
RAG_TOP_K=6

# --- Demo data ----------------------------------------------------------------
SEED_DEMO=true
DEMO_PASSWORD=Demo-Password-2026

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3000
